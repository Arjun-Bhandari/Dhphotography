# Copy to .env.local and fill in. Everything is optional for local development:
# without these, inquiries are logged to the terminal instead of saved/emailed.

# Public address of the site, used for the sitemap, robots.txt and share links
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Neon Postgres connection string (Neon dashboard → Connect → pooled connection)
DATABASE_URL=

# Resend (resend.com) for inquiry emails
RESEND_API_KEY=
# Where inquiries are sent (defaults to the email in src/lib/site.ts)
INQUIRY_TO_EMAIL=
# Sender; must be on a domain verified in Resend (defaults to Resend's test sender)
INQUIRY_FROM_EMAIL=

# Dashboard sign-in (/dashboard)
ADMIN_PASSWORD=
# Long random string, e.g. from: openssl rand -base64 48
SESSION_SECRET=
